; Engine configuration file.
config_version=5

[application]

config/name="HollowVeil"
config/description="HollowVeil — A Casa Morvant. Horror em primeira pessoa com enigmas."
run/main_scene="res://main.tscn"
config/icon="res://icon.png"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/version="1.0.2"
boot_splash/bg_color=Color(0.03, 0.03, 0.035, 1)
boot_splash/show_image=false

[autoload]

State="*res://scripts/core/state.gd"
Audio="*res://scripts/audio/audio.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[gui]

theme/custom="res://resources/ui_theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
limits/opengl/max_lights_per_object=16
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.025, 1)
